{
  "expo": {
    "name": "mega-fitness-mobile",
    "slug": "mega-fitness-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/png/mega-fitness-logo.png",
    "scheme": "megafitnessmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.iewwei.megafitnessmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/png/mega-fitness-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/png/mega-fitness-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
